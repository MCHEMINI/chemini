Options -Indexes
AddType application/manifest+json .webmanifest
DirectoryIndex index.php

<IfModule mod_rewrite.c>
RewriteEngine On

# HTTPS obligatoire
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Dossiers privés
RewriteRule ^(app|data)(/|$) - [F,L]
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule (^|/)\. - [F,L]

# Contrôleur frontal
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L,QSA]
</IfModule>

<FilesMatch "\.(sqlite|sqlite-wal|sqlite-shm|log|md)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  # Plateforme privée : aucun référencement, fichiers compris
  Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
  <FilesMatch "\.(css|js|svg|png)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
